119: // ── Helpers ──────────────────────────────────────────────────────────────────
120: function fmtTime(ts) {
121:   if (!ts) return '—';
122:   try {
123:     return parseUtc(ts).toLocaleTimeString('en-GB', { hour12: false });
124:   } catch { return ts; }
125: }
126: 
127: function fmtDateTime(ts) {
128:   if (!ts) return '—';
129:   try {
130:     const d = parseUtc(ts);
131:     return d.toLocaleString('en-GB', {
132:       month: '2-digit', day: '2-digit',
133:       hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false,
134:     });
135:   } catch { return ts; }
136: }
137: 
138: function alertTypeLabel(type) {
139:   if (type === 'REPEATED_FAILURE') return 'BRUTE FORCE';
140:   if (type === 'SUCCESS_AFTER_FAILURES') return 'ANOMALY';
141:   return type;
142: }
