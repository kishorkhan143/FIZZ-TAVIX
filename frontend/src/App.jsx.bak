500: // ── Main App ───────────────────────────────────────────────────────────────────
501: export default function App() {
502:   const { events, alerts, stats, health } = useAuthSentinel();
503:   const [activeMenu, setActiveMenu] = useState('overview');
504: 
505:   // Map menu IDs to labels and categories
506:   const menuConfig = {
507:     overview: { label: 'Overview', category: 'MONITORING' },
508:     live: { label: 'Live Telemetry', category: 'MONITORING' },
509:     incidents: { label: 'Incidents', category: 'MONITORING' },
510:     labs: { label: 'Laboratories', category: 'INVENTORY' },
511:     terminals: { label: 'Terminals', category: 'INVENTORY' },
512:     csv: { label: 'CSV Analyzer', category: 'TOOLS' },
513:     settings: { label: 'Settings', category: 'SYSTEM' },
514:   };
515: 
516:   const currentMenu = menuConfig[activeMenu] || { label: 'Overview', category: 'MONITORING' };
517: 
518:   return (
519:     <div className="app-wrapper">
520:       <Sidebar activeMenu={activeMenu} onMenuChange={setActiveMenu} />
521:       
522:       <div className="main-content">
523:         <Header 
524:           currentMenuLabel={currentMenu.label}
525:           currentCategory={currentMenu.category}
526:         />
527:         
528:         <div className="body">
529:           {activeMenu === 'overview' && <OverviewSection stats={stats} events={events} alerts={alerts} />}
530:           {activeMenu === 'live' && <LiveTelemetrySection events={events} alerts={alerts} />}
531:           {activeMenu === 'incidents' && <IncidentsSection alerts={alerts} />}
532:           {activeMenu === 'labs' && (
533:             <div className="section">
534:               <div className="section-header">
535:                 <h2>Laboratories</h2>
536:                 <p>Configure test environments</p>
537:               </div>
538:               <div className="empty-state">
539:                 <p>No laboratories configured</p>
540:               </div>
541:             </div>
542:           )}
543:           {activeMenu === 'terminals' && (
544:             <div className="section">
545:               <div className="section-header">
546:                 <h2>Terminals</h2>
547:                 <p>Manage system terminals</p>
548:               </div>
549:               <div className="empty-state">
550:                 <p>No terminals connected</p>
551:               </div>
552:             </div>
553:           )}
554:           {activeMenu === 'csv' && <CsvAnalyticsPage />}
555:           {activeMenu === 'settings' && <SettingsSection health={health} />}
556:         </div>
557:       </div>
558:     </div>
559:   );
560: }
