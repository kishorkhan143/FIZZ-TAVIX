446: function EventsTable({ events }) {
447:   if (!events.length) {
448:     return (
449:       <div className="empty-state">
450:         <p>No events to display</p>
451:       </div>
452:     );
453:   }
454: 
455:   return (
456:     <div className="events-list">
457:       {events.map((ev) => (
458:         <div key={ev.id} className={`event-row ${ev.status}`}>
459:           <div className="event-time">{fmtTime(ev.timestamp)}</div>
460:           <div className="event-user">{ev.username || '—'}</div>
461:           <div className="event-ip">{ev.source_ip || '—'}</div>
462:           <div className={`event-status ${ev.status}`}>
463:             {ev.status === 'SUCCESS' ? (
464:               <Icon name="check-circle" size={16} />
465:             ) : (
466:               <Icon name="x-circle" size={16} />
467:             )}
468:           </div>
469:           <div className={`risk-level ${ev.risk_level}`}>{ev.risk_level}</div>
470:         </div>
471:       ))}
472:     </div>
473:   );
474: }
475: 
476: function AlertList({ alerts }) {
477:   if (!alerts.length) {
478:     return (
479:       <div className="empty-state">
480:         <p>No alerts to display</p>
481:       </div>
482:     );
483:   }
484: 
485:   return (
486:     <div className="alerts-list">
487:       {alerts.map((al) => (
488:         <div key={al.id} className={`alert-row ${al.risk_level}`}>
489:           <div className="alert-type">{alertTypeLabel(al.alert_type)}</div>
490:           <div className="alert-user">{al.username}</div>
491:           <div className="alert-ip">{al.source_ip}</div>
492:           {al.failure_count > 0 && <div className="alert-count">×{al.failure_count}</div>}
493:           <div className="alert-time">{fmtDateTime(al.triggered_at)}</div>
494:         </div>
495:       ))}
496:     </div>
497:   );
498: }
