# LabGuard SSH Security Module Configuration Template

# Initial Policy Mode: MONITOR_ONLY (default), DISABLE_SSH, or ALLOWLIST
# In MONITOR_ONLY mode, no system changes can be performed.
LABGUARD_SSH_POLICY=MONITOR_ONLY

# Administrator secret key required for administrative action endpoints
# (e.g. updating policies, disabling SSH, applying firewall rules)
LABGUARD_ADMIN_KEY=change-this-to-a-strong-secret-token

# Master Safety Switch:
# When set to false (default), live systemd service stops and firewall changes
# are blocked unconditionally, preventing accidental disruption during development.
# Set to 'true' only on authorized live hosts requiring direct control.
LABGUARD_ALLOW_PRIVILEGED_OPERATIONS=false

# Location of structured JSON-lines audit log
LABGUARD_AUDIT_LOG_PATH=labguard_ssh_audit.log

# API host and port (defaults to 127.0.0.1 for local isolation)
LABGUARD_API_HOST=127.0.0.1
LABGUARD_API_PORT=8000

# OpenSSH configuration paths (Ubuntu/Debian defaults)
LABGUARD_SSH_CONFIG_FILE=/etc/ssh/sshd_config
LABGUARD_SSH_CONFIG_DIR=/etc/ssh/sshd_config.d

# Remote Windows PC Monitoring over Tailscale
# URL pointing to the Windows PC agent (e.g. http://<windows-tailscale-ip>:8001)
LABGUARD_WINDOWS_AGENT_URL=http://100.x.y.z:8001
# Shared secret bearer token matching LABGUARD_AGENT_TOKEN on the Windows agent
LABGUARD_WINDOWS_AGENT_TOKEN=change-this-to-a-strong-agent-bearer-token

